# Copy this file as .env and fill in your values
DISCORD_TOKEN=paste-your-discord-token-here

# VoiceStudio runs locally on port 3900 by default
VOICESTUDIO_URL=http://127.0.0.1:3900
# Voice profile ID or name saved in VoiceStudio ("default" for base voice)
VOICESTUDIO_VOICE=default
# Only needed if VoiceStudio requires remote authentication (leave blank for local)
VOICESTUDIO_API_KEY=

# Maximum character limit per TTS message
MAX_CHARS=400

# 1 to automatically start the bot when launching the web panel, 0 for manual start
AUTOSTART=0
