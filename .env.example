# Copiar este archivo como .env y completar tus valores
DISCORD_TOKEN=pega-aqui-tu-token-de-discord

# VoiceStudio corre local en el puerto 3900 por defecto
VOICESTUDIO_URL=http://127.0.0.1:3900
# ID o nombre del perfil de voz guardado en VoiceStudio ("default" para la voz base)
VOICESTUDIO_VOICE=default
# Solo si VoiceStudio requiere autenticación remota (dejar vacío en local)
VOICESTUDIO_API_KEY=

# Límite máximo de caracteres por mensaje
MAX_CHARS=400

# 1 para iniciar el bot automáticamente al abrir el panel web, 0 para inicio manual
AUTOSTART=0
